# Copy this file to .env.local and fill in the values.
# See supabase/README.md for how to obtain each.

# Supabase project URL (from Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (from Project Settings → API)
VITE_SUPABASE_ANON_KEY=eyJ...

# One-way hash salt for telemetry family IDs.
# Generate once:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Use the SAME value in production. If it changes, historical telemetry stops correlating.
VITE_TELEMETRY_HASH_SALT=replace-me-with-random-hex

# Public origin of the app. Used by the invite-family-member Edge Function
# to build the accept link in the invite email. No trailing slash.
# Local dev:  http://localhost:5173
# Preview:    https://<branch>-family-pirate-ship.vercel.app
# Production: https://family-pirate-ship.vercel.app
VITE_PUBLIC_APP_URL=http://localhost:5173
